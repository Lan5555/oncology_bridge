  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "code"
        ],
        "additionalProperties": false
      },
      "FormOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false
      },
      "FormOptionsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "context": {
                    "const": "prescription"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "insurers": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/FormOption"
                        }
                      }
                    },
                    "required": [
                      "insurers"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "context",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "context": {
                    "const": "marketplace"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "categories": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/FormOption"
                        }
                      }
                    },
                    "required": [
                      "categories"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "context",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "context": {
                    "const": "settings"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "currencies": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/FormOption"
                        }
                      }
                    },
                    "required": [
                      "currencies"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "context",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "context": {
                    "const": "reports"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "reportFormats": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/FormOption"
                        }
                      }
                    },
                    "required": [
                      "reportFormats"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "context",
                  "options"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ],
        "additionalProperties": false
      },
      "Pharmacy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "ACTIVE"
          },
          "verified": {
            "const": true
          }
        },
        "required": [
          "id",
          "name",
          "city",
          "status",
          "verified"
        ],
        "additionalProperties": false
      },
      "PharmacyDirectoryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Pharmacy"
                }
              },
              "pagination": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "page",
                  "limit",
                  "total"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "items",
              "pagination"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ],
        "additionalProperties": false
      },
      "Facility": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "drug": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit": {
            "type": "string"
          },
          "lot": {
            "type": "string"
          },
          "donorFacility": {
            "$ref": "#/components/schemas/Facility"
          },
          "recipientFacility": {
            "$ref": "#/components/schemas/Facility"
          },
          "status": {
            "type": "string",
